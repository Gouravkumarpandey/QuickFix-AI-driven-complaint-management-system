FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production MONGOMS_DISABLE_POSTINSTALL=1
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY src ./src
COPY worker ./worker
RUN mkdir -p /var/lib/quickfix/private && chown -R node:node /app /var/lib/quickfix
USER node
EXPOSE 5000
CMD ["node","src/server.js"]
